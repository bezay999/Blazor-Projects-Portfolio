@page "/"
@using SecureNotesManager.Logic
@inject NoteEncryptor EncryptorService
@rendermode InteractiveServer

<PageTitle>Secure Notes</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Secure Notes Manager</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">Type your text below to encrypt or paste encrypted text to decrypt.</p>

            <div class="mb-3">
                <label class="form-label">Input Text:</label>
                <textarea class="form-control font-monospace"
                          @bind="InputText"
                          placeholder="Enter text here..." 
                          rows="4"></textarea>
            </div>

            <div class="d-flex gap-2 mb-4">
                <button class="btn btn-dark" @onclick="EncryptText">
                    <i class="oi oi-lock-locked"></i> Encrypt
                </button>
                <button class="btn btn-secondary" @onclick="DecryptText">
                    <i class="oi oi-lock-unlocked"></i> Decrypt
                </button>
                <button class="btn btn-danger ms-auto" @onclick="Clear">
                    Clear All
                </button>
            </div>

            @if (!string.IsNullOrEmpty(ResultText))
            {
                <div class="alert alert-info">
                    <strong>Result:</strong>
                    <p class="font-monospace mt-2 mb-0">@ResultText</p>
                    <button class="btn btn-sm btn-outline-primary mt-2" @onclick="CopyResultToInput">
                        Use Result as Input
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    
    private string InputText { get; set; } = "";
    private string ResultText { get; set; } = "";

    
    private void EncryptText()
    {
        if (!string.IsNullOrWhiteSpace(InputText))
        {
            ResultText = EncryptorService.Encrypt(InputText);
        }
    }

    
    private void DecryptText()
    {
        if (!string.IsNullOrWhiteSpace(InputText))
        {
            ResultText = EncryptorService.Decrypt(InputText);
        }
    }
    
    private void Clear()
    {
        InputText = "";
        ResultText = "";
    }
    
    private void CopyResultToInput()
    {
        InputText = ResultText;
        ResultText = "";
    }
}